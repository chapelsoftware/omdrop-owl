@@ -83,11 +84,43 @@ static void daemonize() {
 	openlog("owl", LOG_PID, LOG_DAEMON);
 }
 
+static const char *owl_chan_file;
+
+/* -C: our channel, reread on SIGUSR2. With -F it is where we are in every
+ * slot: what the sequence offers peers and what the unicast gate opens on. */
+static void retune_cb(struct ev_loop *loop, ev_signal *w, int revents) {
+	struct daemon_state *state = w->data;
+	FILE *f = fopen(owl_chan_file, "r");
+	int c = 0;
+
+	(void) loop;
+	(void) revents;
+	if (!f || fscanf(f, "%d", &c) != 1) {
+		if (f)
+			fclose(f);
+		log_warn("retune: cannot read a channel from %s", owl_chan_file);
+		return;
+	}
+	fclose(f);
+	switch (c) {
+		case 6: state->awdl_state.channel.master = CHAN_OPCLASS_6; break;
+		case 36: state->awdl_state.channel.master = CHAN_OPCLASS_36; break;
+		case 44: state->awdl_state.channel.master = CHAN_OPCLASS_44; break;
+		case 149: state->awdl_state.channel.master = CHAN_OPCLASS_149; break;
+		default:
+			log_warn("retune: unsupported channel %d", c);
+			return;
+	}
+	log_info("retune: our channel is now %d", c);
+}
+
