+/*
+ * awdl_share: a monitor interface beside an associated station, as OWL runs
+ * AWDL on the station's channel. With the module parameter set and mac80211
+ * asking for other BSSs' frames, the station's MAC context accepts everything
+ * (the firmware otherwise drops AWDL's frames, whose BSSID isn't the AP's),
+ * and a sniffer station on its link carries what the monitor injects with the
+ * station's address: mac80211 sends those through the station vif, where
+ * there's no station entry for the peer to send them from.
+ * Not with a real monitor vif (exclusive use), which owns the sniffer station.
+ */
+static void iwl_mvm_awdl_share_iter(void *data, u8 *mac,
+				    struct ieee80211_vif *vif)
+{
+	struct ieee80211_vif **found = data;
+
+	if (!*found && vif->type == NL80211_IFTYPE_STATION && !vif->p2p &&
+	    vif->cfg.assoc && !ieee80211_vif_is_mld(vif) &&
+	    iwl_mvm_vif_from_mac80211(vif)->uploaded)
+		*found = vif;
+}
+
+void iwl_mvm_awdl_share_release(struct iwl_mvm *mvm, struct ieee80211_vif *vif)
+{
+	lockdep_assert_held(&mvm->mutex);
+
+	if (!vif || mvm->awdl_share_vif != vif)
+		return;
+
+	if (mvm->snif_sta.sta_id != IWL_MVM_INVALID_STA)
+		iwl_mvm_mld_rm_snif_sta(mvm, vif);
+	WRITE_ONCE(mvm->awdl_share_vif, NULL);
+	if (iwl_mvm_vif_from_mac80211(vif)->uploaded)
+		iwl_mvm_mld_mac_ctxt_changed(mvm, vif, false);
+	IWL_INFO(mvm, "awdl_share: off (%pM)\n", vif->addr);
+}
+
+void iwl_mvm_awdl_share_update(struct iwl_mvm *mvm)
+{
+	struct ieee80211_vif *vif = NULL;
+	int ret;
+
+	lockdep_assert_held(&mvm->mutex);
+
+	if (!mvm->mld_api_is_used ||
+	    test_bit(IWL_MVM_STATUS_IN_HW_RESTART, &mvm->status))
+		return;
+
+	if (iwlmvm_mod_params.awdl_share && mvm->other_bss_wanted &&
+	    !mvm->monitor_on)
+		ieee80211_iterate_active_interfaces_mtx(mvm->hw,
+				IEEE80211_IFACE_ITER_NORMAL,
+				iwl_mvm_awdl_share_iter, &vif);
+
+	if (vif == mvm->awdl_share_vif)
+		return;
+
+	iwl_mvm_awdl_share_release(mvm, mvm->awdl_share_vif);
+	if (!vif || WARN_ON(mvm->snif_sta.sta_id != IWL_MVM_INVALID_STA))
+		return;
+
+	WRITE_ONCE(mvm->awdl_share_vif, vif);
+	ret = iwl_mvm_mld_mac_ctxt_changed(mvm, vif, false);
+	if (!ret)
+		ret = iwl_mvm_mld_add_snif_sta(mvm, vif, &vif->bss_conf);
+	if (ret) {
+		IWL_ERR(mvm, "awdl_share: failed to share %pM (%d)\n",
+			vif->addr, ret);
+		WRITE_ONCE(mvm->awdl_share_vif, NULL);
+		iwl_mvm_mld_mac_ctxt_changed(mvm, vif, false);
+		return;
+	}
+	IWL_INFO(mvm, "awdl_share: on (%pM, sniffer sta %d, queue %d)\n",
+		 vif->addr, mvm->snif_sta.sta_id, mvm->snif_queue);
+}
+
